{
  "name": "desk",
  "version": "1.1.3",
  "private": true,
  "description": "Open-source AI support app: chat widget, help center and team dashboard, powered by ModelRiver.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --port 3000",
    "build": "node node_modules/vite/bin/vite.js build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.ts",
    "cleanup-archived": "node --env-file-if-exists=.env scripts/cleanup-archived.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check-versions": "node scripts/check-versions.mjs"
  },
  "dependencies": {
    "@modelriver/client": "1.7.0",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
