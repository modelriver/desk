# /etc/desk/env  (chmod 600, owned by root)
NODE_ENV=production
MODELRIVER_API_KEY=
# MODELRIVER_API_URL defaults to https://api.modelriver.com/v1; set it only for another server.
MODELRIVER_WORKFLOW=support_assistant
DATA_DIR=/var/lib/desk/data
DATABASE_PATH=/var/lib/desk/desk.db
HOST=127.0.0.1
PORT=3000
# One reverse proxy (nginx) in front; see README > Abuse protection
TRUST_PROXY_HOPS=1
CLIENT_IP_HEADER=
GLOBAL_MESSAGES_PER_MINUTE=60
GLOBAL_MESSAGES_PER_DAY=2000
PUBLIC_REPO_URL=https://github.com/modelriver/desk
# Sites allowed to embed the chat widget, space-separated (empty = this site only)
WIDGET_FRAME_ANCESTORS=
# Keep your theme next to your data instead of in the app folder
# SUPPORT_CONFIG=/var/lib/desk/support.config.json
VISITOR_COOKIE_DAYS=30
# Password-only sign-in. Leave off while the sign-in page is reachable from the internet.
# DISABLE_TWO_FACTOR=true

# Integrations: encrypts connector keys saved on the Integrations page (setup-server.sh makes one):
#   openssl rand -base64 32
# DESK_SECRET_KEY=
# Signs identity tokens from your own site for signed-in visitors (at least 32 characters):
# DESK_IDENTITY_SECRET=
# How long a visitor's verified email counts, in hours (it also lapses after 2 hours without a message).
# VERIFIED_HOURS=24

# Archived conversations are deleted, in ModelRiver too, this many hours after
# they were archived (0 = keep them until restored).
ARCHIVE_RETENTION_HOURS=24

# Email notifications for the team (each person picks theirs in Account settings).
# EMAIL_PROVIDER: resend, postmark, ses, or log (prints to the server log). Unset = no email.
# EMAIL_PROVIDER=resend
# EMAIL_FROM="Acme Support <support@acme.com>"
# The address people use to open this app, for links in emails.
# APP_URL=https://support.acme.com
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
