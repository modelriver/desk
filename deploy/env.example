# /etc/desk/env  (chmod 600, owned by root)
NODE_ENV=production
MODELRIVER_API_KEY=
# MODELRIVER_API_URL defaults to https://api.modelriver.com/v1; set it only for another server.
MODELRIVER_WORKFLOW=support_assistant
DATA_DIR=/var/lib/desk/data
DATABASE_PATH=/var/lib/desk/desk.db
HOST=127.0.0.1
PORT=3000
# One reverse proxy (nginx) in front; see README > Abuse protection
TRUST_PROXY_HOPS=1
CLIENT_IP_HEADER=
# Site-wide caps on AI answers, set for ModelRiver's Free plan; raise them on a paid plan
GLOBAL_MESSAGES_PER_MINUTE=20
GLOBAL_MESSAGES_PER_DAY=800
PUBLIC_REPO_URL=https://modelriver.com/desk
# Sites allowed to embed the chat widget, space-separated (empty = this site only)
WIDGET_FRAME_ANCESTORS=
# Keep your theme next to your data instead of in the app folder
# SUPPORT_CONFIG=/var/lib/desk/support.config.json
VISITOR_COOKIE_DAYS=30
# Password-only sign-in. Leave off while the sign-in page is reachable from the internet.
# DISABLE_TWO_FACTOR=true

# Integrations: encrypts connector keys saved on the Integrations page (setup-server.sh makes one):
#   openssl rand -base64 32
# DESK_SECRET_KEY=
# Signs identity tokens from your own site for signed-in visitors (at least 32 characters):
# DESK_IDENTITY_SECRET=
# How long a visitor's verified email counts, in hours (it also lapses after 2 hours without a message).
# VERIFIED_HOURS=24

# Archived conversations are deleted, in ModelRiver too, this many hours after
# they were archived (0 = keep them until restored).
ARCHIVE_RETENTION_HOURS=24

# Email (recommended): raising and answering tickets, email verification for
# account lookups, and team notifications all need it. Each team member picks
# their own notifications in Account settings.
# EMAIL_PROVIDER: resend, postmark, ses, or log (prints to the server log). Unset = no email.
# EMAIL_PROVIDER=resend
# EMAIL_FROM="Acme Support <support@acme.com>"
# Where customers' replies to ticket emails go (a mailbox your team reads). Unset = EMAIL_FROM.
# SUPPORT_REPLY_TO=support@acme.com
# The address people use to open this app, for links in emails.
# APP_URL=https://support.acme.com
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Images pasted, dropped or uploaded into articles. By default they're saved in
# DATA_DIR/media and served at /media/. MEDIA_DIR puts them somewhere else
# (outside /var/lib/desk, add it to ReadWritePaths in desk.service too).
# MEDIA_DIR=
# Or keep them in S3-compatible storage (Amazon S3, Cloudflare R2, MinIO, ...)
# and load them from its public address or your CDN. Set the four required
# settings together; the key needs to write objects to the bucket.
# MEDIA_S3_BUCKET=help-images
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_URL=https://cdn.acme.com
# Amazon S3 uses MEDIA_S3_REGION; R2 and others also need their endpoint, e.g.
# https://<account-id>.r2.cloudflarestorage.com (region "auto" is picked for R2).
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_REGION=us-east-1
# A folder inside the bucket, e.g. desk/ (images are then at MEDIA_PUBLIC_URL/desk/...).
# MEDIA_S3_PREFIX=
