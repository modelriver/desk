# Settings for docker compose. Save as .env next to docker-compose.yml (kept
# out of git and the image) and fill it in:
#   cp deploy/docker/env.example .env
# Paths, the port and TRUST_PROXY_HOPS are set in docker-compose.yml.

# The Desk image to run. 1 follows every 1.x release; pin one with e.g. 1.0.0.
# DESK_VERSION=1

# Your Desk's address. Caddy gets its certificate; point its DNS here first.
DESK_DOMAIN=support.example.com
APP_URL=https://support.example.com

MODELRIVER_API_KEY=
MODELRIVER_API_URL=https://api.modelriver.com/v1
MODELRIVER_WORKFLOW=support_assistant

# Integrations. Make each once and never change DESK_SECRET_KEY afterwards:
# connector keys saved on the Integrations page can't be read without it.
#   openssl rand -base64 32     (DESK_SECRET_KEY)
#   openssl rand -base64 48     (DESK_IDENTITY_SECRET)
DESK_SECRET_KEY=
DESK_IDENTITY_SECRET=
# VERIFIED_HOURS=24

# Start with the example articles (only into an empty data folder).
# DESK_SAMPLE_DATA=true

# Site-wide caps on AI answers, set for ModelRiver's Free plan; raise them on a paid plan
GLOBAL_MESSAGES_PER_MINUTE=20
GLOBAL_MESSAGES_PER_DAY=800
# Sites allowed to embed the chat widget, space-separated (empty = this site only)
WIDGET_FRAME_ANCESTORS=
ARCHIVE_RETENTION_HOURS=24

# Email (recommended): raising and answering tickets, email verification for
# account lookups, and team notifications all need it.
# EMAIL_PROVIDER: resend, postmark, ses, or log. Unset = no email.
# EMAIL_PROVIDER=resend
# EMAIL_FROM="Acme Support <support@acme.com>"
# Where customers' replies to ticket emails go (a mailbox your team reads). Unset = EMAIL_FROM.
# SUPPORT_REPLY_TO=support@acme.com
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Images pasted, dropped or uploaded into articles. By default they're saved in
# the Desk volume and served at /media/.
# Or keep them in S3-compatible storage (Amazon S3, Cloudflare R2, MinIO, ...)
# and load them from its public address or your CDN. Set the four required
# settings together; the key needs to write objects to the bucket.
# MEDIA_S3_BUCKET=help-images
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_URL=https://cdn.acme.com
# Amazon S3 uses MEDIA_S3_REGION; R2 and others also need their endpoint, e.g.
# https://<account-id>.r2.cloudflarestorage.com (region "auto" is picked for R2).
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_REGION=us-east-1
# A folder inside the bucket, e.g. desk/ (images are then at MEDIA_PUBLIC_URL/desk/...).
# MEDIA_S3_PREFIX=
