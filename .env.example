# Copy to .env and fill in. Never commit .env.

# ModelRiver API key (console -> project -> API keys). Paste yours here.
MODELRIVER_API_KEY=
# ModelRiver API address. Leave it unset to use https://api.modelriver.com/v1.
# MODELRIVER_API_URL=https://api.modelriver.com/v1
# Name of the ModelRiver workflow that answers support questions (sessions enabled)
MODELRIVER_WORKFLOW=support_assistant

# Folder with public/ and private/ subfolders. The sample folder works out of the box.
DATA_DIR=./examples/data
# SQLite file for users, roles, article metadata and conversation -> session mapping
DATABASE_PATH=./var/support.db

PORT=3000
# Where "Open source, built on ModelRiver" links, in the help center footer and
# chat widget: Desk's page by default. Point it at your fork if you change the code.
PUBLIC_REPO_URL=https://modelriver.com/desk
# How rate limits find the visitor's IP. Leave both empty when nothing sits in
# front of the app. Behind nginx/Caddy: TRUST_PROXY_HOPS=1. Behind Cloudflare
# then nginx: CLIENT_IP_HEADER=cf-connecting-ip (only if the app can't be
# reached except through Cloudflare). Never trust more hops than you really have.
TRUST_PROXY_HOPS=0
CLIENT_IP_HEADER=
# Site-wide caps on AI answers, whatever IP they come from (0 = no cap).
# Set for ModelRiver's Free plan (30 calls a minute per IP, 25,000 AI requests
# a month); raise them on a paid plan. See README > Abuse protection.
GLOBAL_MESSAGES_PER_MINUTE=20
GLOBAL_MESSAGES_PER_DAY=800
# Address the production server binds to (use 0.0.0.0 in containers)
HOST=127.0.0.1
# Sites allowed to embed /widget in an iframe (CSP frame-ancestors), space-separated.
# Unset means only this site.
# WIDGET_FRAME_ANCESTORS=https://your-site.example

# Look and feel (colours, fonts, brand name). Defaults to ./support.config.json
# SUPPORT_CONFIG=./support.config.json

# How long a visitor's chat is remembered after their last message, in days (0 = until the browser closes)
VISITOR_COOKIE_DAYS=30

# Turn off the authenticator-code step at sign-in (password only). For local
# development, or a dashboard reachable only behind your own VPN or SSO.
# DISABLE_TWO_FACTOR=true

# Archived conversations are deleted, in ModelRiver too, this many hours after
# they were archived (0 = keep them until restored).
ARCHIVE_RETENTION_HOURS=24

# Email notifications for the team (each person picks theirs in Account settings).
# EMAIL_PROVIDER: resend, postmark, ses, or log (prints to the server log). Unset = no email.
# EMAIL_PROVIDER=resend
# EMAIL_FROM="Acme Support <support@acme.com>"
# The address people use to open this app, for links in emails.
# APP_URL=https://support.acme.com
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=   # only for temporary credentials

# Images pasted, dropped or uploaded into articles. By default they're saved in
# DATA_DIR/media and served at /media/. MEDIA_DIR puts them somewhere else.
# MEDIA_DIR=
# Or keep them in S3-compatible storage (Amazon S3, Cloudflare R2, MinIO, ...)
# and load them from its public address or your CDN. Set the four required
# settings together; the key needs to write objects to the bucket.
# MEDIA_S3_BUCKET=help-images
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_URL=https://cdn.acme.com
# Amazon S3 uses MEDIA_S3_REGION; R2 and others also need their endpoint, e.g.
# https://<account-id>.r2.cloudflarestorage.com (region "auto" is picked for R2).
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_REGION=us-east-1
# A folder inside the bucket, e.g. desk/ (images are then at MEDIA_PUBLIC_URL/desk/...).
# MEDIA_S3_PREFIX=

# --- Integrations (Dashboard -> Integrations): read-only lookups for verified visitors ---
# Encrypts connector keys saved on the Integrations page (32 bytes, base64):
#   openssl rand -base64 32
# Without it, connector keys can only be set below.
# DESK_SECRET_KEY=
# How long a visitor's verified email counts, in hours (0 = until the chat ends).
# It also lapses after 2 hours without a message from them.
# VERIFIED_HOURS=24
# Signs identity tokens from your own site for signed-in visitors (at least 32 characters).
# DESK_IDENTITY_SECRET=
# Let Custom HTTP and a self-hosted Cal.com reach private network addresses (localhost, 10.x, 192.168.x).
# DESK_ALLOW_PRIVATE_CONNECTOR_URLS=true
# Connector settings. Set here, they win over the Integrations page.
# SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2026-04
# STRIPE_RESTRICTED_KEY=
# CALCOM_API_KEY=
# CALCOM_API_URL=https://api.cal.com
# CALCOM_APP_URL=https://cal.com
# CUSTOM_HTTP_URL=https://api.example.com/desk/lookup
# CUSTOM_HTTP_SECRET=
# CUSTOM_HTTP_NAME=Account system
# CUSTOM_HTTP_TOPICS=licence, seats, account
